# Copy to .env (git-ignored) for local overrides. Placeholders only - never real values here.
# API keys for the gateway when auth.enabled: "tenant:key" pairs (keys >= 16 chars).
INFERENCELAB_API_KEYS=team-a:replace-with-a-long-random-key
# Key for HTTP backends that require one (referenced by api_key_env in backend configs).
VLLM_API_KEY=
# Hugging Face token belongs on the GPU host (~/.inferencelab/env), not on the laptop.
